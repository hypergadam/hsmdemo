# hsmdemo -- PKCS#11 / SoftHSM development tasks.
#
# Quick start:
#   cp .env.example .env && $EDITOR .env   # set HSM_PIN and HSM_SO_PIN
#   just doctor                            # check the toolchain
#   just run                               # create the token if needed, then sign

set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-load
set export

# --- Configuration --------------------------------------------------------

# PKCS#11 provider. Override in .env to point at a hardware HSM.
PKCS11_LIB := env('PKCS11_LIB', '/usr/lib64/pkcs11/libsofthsm2.so')

# Project-local SoftHSM store: no root, no state shared with other projects.
# libsofthsm2.so reads SOFTHSM2_CONF when C_Initialize runs, so softhsm2-util,
# pkcs11-tool and `go run .` all resolve to the same token store.
softhsm_dir   := justfile_directory() / '.softhsm'
token_dir     := softhsm_dir / 'tokens'
SOFTHSM2_CONF := softhsm_dir / 'softhsm2.conf'

# These must match the constants in main.go.
token_label := 'ca-token'
key_label   := 'ca-signing-key'

binary := 'hsmdemo'

# Show the available recipes.
default:
    @just --list

# --- Token lifecycle ------------------------------------------------------

# Write the project-local SoftHSM config. Idempotent; a dependency of most recipes.
[group('token')]
init:
    @mkdir -p '{{ token_dir }}'
    @printf '%s\n' \
        '# Generated by `just init`. Edit the justfile, not this file.' \
        'directories.tokendir = {{ token_dir }}' \
        'objectstore.backend = file' \
        'objectstore.umask = 0077' \
        'log.level = INFO' \
        > '{{ SOFTHSM2_CONF }}'

# Initialise the token; needs HSM_PIN and HSM_SO_PIN. Prefer `token-ensure`.
[group('token')]
token-init: init
    @test -n "${HSM_PIN:-}"    || { echo 'HSM_PIN is empty -- set it in .env' >&2; exit 1; }
    @test -n "${HSM_SO_PIN:-}" || { echo 'HSM_SO_PIN is empty -- set it in .env' >&2; exit 1; }
    softhsm2-util --init-token --free \
        --label '{{ token_label }}' \
        --so-pin "$HSM_SO_PIN" \
        --pin "$HSM_PIN"

# Initialise the token only if it is not there yet.
[group('token')]
token-ensure: init
    @slots="$(softhsm2-util --show-slots 2>/dev/null || true)"; \
    if grep -qE 'Label:[[:space:]]+{{ token_label }}' <<< "$slots"; then \
        echo 'token "{{ token_label }}" already present'; \
    else \
        just token-init; \
    fi

# Show every slot and its token info.
[group('token')]
slots: init
    softhsm2-util --show-slots

# Destroy the local token store and every key in it.
[group('token')]
[confirm('This deletes the local token and every key inside it. Continue?')]
token-reset:
    rm -rf '{{ softhsm_dir }}'
    @echo 'token store removed -- `just token-init` recreates it'

# --- Inspection -----------------------------------------------------------

# List all objects in the token. Proves the private key is sensitive and non-extractable.
[group('inspect')]
objects: init
    @test -n "${HSM_PIN:-}" || { echo 'HSM_PIN is empty -- set it in .env' >&2; exit 1; }
    pkcs11-tool --module "$PKCS11_LIB" --token-label '{{ token_label }}' \
        --login --pin "$HSM_PIN" --list-objects

# Show only the CA signing key.
[group('inspect')]
key-info: init
    @test -n "${HSM_PIN:-}" || { echo 'HSM_PIN is empty -- set it in .env' >&2; exit 1; }
    pkcs11-tool --module "$PKCS11_LIB" --token-label '{{ token_label }}' \
        --login --pin "$HSM_PIN" --list-objects --label '{{ key_label }}'

# List the EC mechanisms the provider supports.
[group('inspect')]
mechanisms: init
    pkcs11-tool --module "$PKCS11_LIB" --list-mechanisms | grep -iE 'ecdsa|ec-key'

# Report every prerequisite at once: tools, library, config, token, PIN.
[group('inspect')]
doctor:
    #!/usr/bin/env bash
    # Deliberately no `set -e`: report all problems, not just the first.
    pass() { printf '  [ok]   %-16s %s\n' "$1" "$2"; }
    fail() { printf '  [FAIL] %-16s %s\n' "$1" "$2"; failed=1; }
    failed=0

    echo 'tools'
    for t in go just softhsm2-util pkcs11-tool; do

        if command -v "$t" >/dev/null 2>&1; then pass "$t" "$(command -v "$t")"
        else fail "$t" 'not on PATH'; fi
    done

    echo 'provider'
    if [[ -f "$PKCS11_LIB" ]]; then pass 'PKCS11_LIB' "$PKCS11_LIB"
    else fail 'PKCS11_LIB' "$PKCS11_LIB (not found)"; fi

    echo 'config'
    if [[ -f "$SOFTHSM2_CONF" ]]; then pass 'SOFTHSM2_CONF' "$SOFTHSM2_CONF"
    else fail 'SOFTHSM2_CONF' "$SOFTHSM2_CONF (run \`just init\`)"; fi

    echo 'secrets'
    [[ -n "${HSM_PIN:-}"    ]] && pass 'HSM_PIN' 'set' || fail 'HSM_PIN' 'empty or unset (.env)'
    [[ -n "${HSM_SO_PIN:-}" ]] && pass 'HSM_SO_PIN' 'set' || fail 'HSM_SO_PIN' 'empty or unset (.env)'

    echo 'token'
    slots="$(softhsm2-util --show-slots 2>/dev/null || true)"
    if grep -qE "Label:[[:space:]]+{{ token_label }}" <<< "$slots"; then
        pass '{{ token_label }}' 'initialised'
    else
        fail '{{ token_label }}' 'not initialised (run `just token-ensure`)'
    fi

    exit "$failed"

# --- Go -------------------------------------------------------------------

# Create the token if needed, then run the demo.
[group('go')]
run: token-ensure
    go run .

# Build the binary.
[group('go')]
build:
    go build -o '{{ binary }}' .

# Run the test suite against a live token.
[group('go')]
test: token-ensure
    go test ./...

# Format the Go sources.
[group('go')]
fmt:
    go fmt ./...

# Run go vet.
[group('go')]
vet:
    go vet ./...

# Run golangci-lint.
[group('go')]
lint:
    golangci-lint run

# fmt, vet, lint and test in one go.
[group('go')]
check: fmt vet lint test

# Tidy go.mod and go.sum.
[group('go')]
tidy:
    go mod tidy

# Remove the built binary.
[group('go')]
clean:
    rm -f '{{ binary }}'

# End-to-end walkthrough: token, signature, then the key attributes.
[group('go')]
demo: token-ensure run objects
