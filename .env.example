# Copy to .env and fill in. .env is gitignored; never commit real PINs.
#
#   cp .env.example .env

# User PIN of the token. Required by the program and by every `just` recipe
# that logs in.
HSM_PIN=

# Security Officer PIN. Used only when the token is created
# (`just token-init` / `just token-ensure`). The Go program never reads it.
HSM_SO_PIN=

# Path to the PKCS#11 provider. Leave this COMMENTED OUT to use the Fedora
# SoftHSM default (/usr/lib64/pkcs11/libsofthsm2.so).
#
# An empty value is not the same as unset: `PKCS11_LIB_PATH=` is an empty override,
# not a request for the default. Find your path with:
#
#   rpm -ql softhsm | grep libsofthsm2.so
#
#PKCS11_LIB_PATH=/usr/lib64/pkcs11/libsofthsm2.so
